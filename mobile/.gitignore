preview/dist/

# Release signing — keep keystore secrets out of git
android/gradle.properties.local
*.jks

# JS bundle + assets embedded into a sideloadable debug APK by CI. Generated,
# never committed: a stale copy here would silently override the real bundle.
android/app/src/main/assets/index.android.bundle
android/app/src/main/res/drawable-*/
# The bundler drops generated assets in here, which is why it is ignored — but
# the app's own sound effects are *source*, generated by scripts/make-sounds.py
# and checked by check:sounds. Ignoring them meant a build that compiled fine
# locally and failed on CI with a missing file.
#
# The rule ignores the folder's *contents* rather than the folder: git cannot
# re-include a file whose parent directory is excluded, so `!` on the wavs
# below would have done nothing at all.
android/app/src/main/res/raw/*
!android/app/src/main/res/raw/tap.wav
!android/app/src/main/res/raw/chime.wav
!android/app/src/main/res/raw/tap_soft.wav
!android/app/src/main/res/raw/tap_crisp.wav
!android/app/src/main/res/raw/chime_bell.wav
!android/app/src/main/res/raw/chime_soft.wav
!android/app/src/main/res/raw/chime_digital.wav

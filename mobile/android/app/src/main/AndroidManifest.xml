<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without this every Vibration.vibrate() call is a silent no-op. The
         focus timer has been calling it since it was written, so its
         completion buzz has never actually fired on a device. Normal-level
         permission: no runtime prompt, it just has to be declared. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Dictation in the Ask AI composer. A runtime permission, unlike the photo
      picker, which needs none because Android's picker runs out of process —
      there is no equivalent for the microphone, so this one is asked for, once,
      the first time the mic is tapped and never at launch.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      One study reminder a day. A runtime permission since Android 13, asked
      for only when the toggle is turned on — never at launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Android drops every alarm on shutdown. Without this the reminders work
      until the first reboot and then stop, silently, with the switch still on.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The advertising ID, and why it is declared HERE rather than left to the
      SDK.

      Play refused version 15 over it: "your advertising ID declaration in Play
      Console says that your app uses advertising ID. A manifest file in one of
      your active artifacts doesn't include the
      com.google.android.gms.permission.AD_ID permission." Since Android 13 an
      app targeting API 33+ that reads the advertising ID must declare this, or
      Play zeroes the identifier out — which for this app means AdMob serving
      untargeted ads and earning a fraction of what it does now.

      The obvious assumption is that the ads library brings it. It does not:
      `react-native-google-mobile-ads` declares INTERNET, WAKE_LOCK and
      ACCESS_NETWORK_STATE and nothing else (read its
      android/src/main/AndroidManifest.xml). It relies on the play-services-ads
      AAR to merge this one in, and whatever that resolved to did not reach the
      shipped artifact — Play read the real merged manifest and it was absent.

      Declaring it in the app's own manifest is Google's documented fix and does
      not depend on which version of the AAR a build resolves. It is a
      normal-level permission: no runtime prompt, and nothing to ask the reader.

      It stays declared in the debug and internal builds too, where
      `adsMode.ts` is overwritten with ADS_ENABLED = false and the SDK never
      starts. A permission the app does not exercise costs nothing; a manifest
      that differs between build types is how a release ships without something
      every test build had.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:enableOnBackInvokedCallback="true"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- OAuth / deep-link callback: com.aistudio.mbbsqbank.aycxvd://… -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="${appAuthRedirectScheme}" />
        </intent-filter>

        <!--
          Open an Anki package from a file manager, a chat or a download.

          The app could already import a `.apkg` — but only from inside, through
          its own picker. Tapping the file anywhere else did not offer Orbit at
          all, which is backwards: a shared deck arrives as a file in WhatsApp
          or Downloads, and that is the moment somebody wants to open it.

          THE MIME TYPE CANNOT BE TRUSTED, so this matches on the extension
          instead. Android derives a `.apkg`'s type from its extension, has no
          entry for one, and hands out `application/octet-stream` — and some
          providers say `application/zip` because a package IS a zip. Matching
          only `application/*` would put Orbit in the chooser for every binary
          file on the phone; matching only `application/zip` would miss most
          real packages.

          `pathPattern` needs BOTH the plain and the escaped-dot form. Android's
          pattern matcher is not a regex: `.` is a literal dot in a pathPattern,
          while `\\.` is what some providers' encoded paths carry, and the two
          are matched separately. The wildcard prefix `.*` before it is required
          because pathPattern anchors at the start of the whole path.

          `mimeType` and `scheme` must both be present or the filter matches
          nothing at all — an intent-filter with a `data` element that names an
          extension but no scheme is silently dead.
        -->
        <intent-filter android:label="@string/apkg_open_label">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="content" />
            <data android:scheme="file" />
            <data android:host="*" />
            <data android:mimeType="application/octet-stream" />
            <data android:mimeType="application/zip" />
            <data android:mimeType="application/x-zip-compressed" />
            <data android:mimeType="application/apkg" />
            <data android:pathPattern=".*\\.apkg" />
            <data android:pathPattern=".*\\..*\\.apkg" />
            <data android:pathPattern=".*\\..*\\..*\\.apkg" />
        </intent-filter>
      </activity>

        <!--
          The daily check. exported="false" because nothing outside the app has
          any business firing it; it is woken by our own AlarmManager only.
        -->
        <receiver
            android:name=".NotifyReceiver"
            android:exported="false" />

        <!--
          Handing one exported deck to the share sheet.

          A file in this app's own storage cannot be sent to WhatsApp or Gmail
          directly: since Android 7 a `file://` URI in an Intent throws
          FileUriExposedException. A FileProvider mints a `content://` URI with
          a one-shot read grant for the receiving app instead.

          `exported="false"` with `grantUriPermissions="true"` is the pair that
          matters: nothing may query this provider on its own, and the only
          access anyone gets is the grant attached to the Intent we send. The
          paths file names a single cache directory, so the one file being
          shared is the only thing reachable.

          The authority carries ${applicationId} rather than the package name
          written out, because the debug and preview builds add a `.debug`
          suffix — two installed builds declaring the same authority is an
          install failure with a message that says nothing useful.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/orbit_file_paths" />
        </provider>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
    <!--
      Android 11 hid other packages from each other. SpeechRecognizer is a
      separate app, so without declaring the intent this app cannot see it and
      isRecognitionAvailable() returns false on every device — the mic would
      simply never appear, with nothing in a log to say why.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>

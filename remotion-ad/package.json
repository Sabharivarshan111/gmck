{
  "name": "orbit-mbbs-remotion-ad",
  "version": "1.0.0",
  "private": true,
  "description": "High-Converting Cinematic Video Ad for Orbit MBBS built with Remotion",
  "scripts": {
    "start": "remotion preview",
    "build": "tsc --noEmit",
    "screens": "node scripts/capture-screens.mjs",
    "plates": "node scripts/fetch-plates.mjs",
    "voice": "node scripts/voice-manifest.mjs",
    "preflight": "node scripts/preflight.mjs",
    "render:pattern": "remotion render orbit-the-pattern out/orbit-the-pattern.mp4",
    "render:2am": "remotion render orbit-2am out/orbit-2am.mp4",
    "render:draw": "remotion render orbit-draw-it-from-memory out/orbit-draw-it-from-memory.mp4",
    "still": "remotion still orbit-the-pattern out/preview-frame.png --frame 300"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.220",
    "@remotion/player": "^4.0.220",
    "lucide-react": "^0.460.0",
    "msedge-tts": "^2.0.7",
    "music-metadata": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.220"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}

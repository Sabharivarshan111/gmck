{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "installCommand": "npm ci --legacy-peer-deps && npm --prefix mobile ci --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/notes",
      "destination": "/index.html"
    },
    {
      "source": "/timer",
      "destination": "/index.html"
    },
    {
      "source": "/ask-ai",
      "destination": "/index.html"
    },
    {
      "source": "/progress",
      "destination": "/index.html"
    },
    {
      "source": "/browse/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/legacy.html"
    }
  ],
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs"
}
